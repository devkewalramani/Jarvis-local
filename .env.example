# JARVIS (local edition): example environment file
# ===================================================================
# Copy this to .env and change only what you need. .env is gitignored.
# `npm start` and the desktop app load it; so does `npm run bridge`.
#
# NEVER put ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN or ANTHROPIC_BASE_URL
# here. Jarvis runs on your Claude subscription login only, and the bridge
# refuses to start if it can see any of them.
#
# Frontend (Vite) settings still go in .env.local as VITE_* variables; only
# VITE_ prefixed values ever reach the browser.


# ===================================================================
# Mail accounts
# ===================================================================
# Which email domain belongs to which organisation, so a new follow up
# draft is written from the right account. Comma separated Org=domain pairs.
# JARVIS_ACCOUNT_DOMAINS=Acme=acme.example,Globex=globex.example


# ===================================================================
# Brains (see bridge/routing.json for which requests go where)
# ===================================================================
# Claude, on your subscription. Defaults shown.
# JARVIS_MODEL=claude-sonnet-5
# JARVIS_EFFORT=medium

# The local model, on the Jarvis only Ollama instance.
# JARVIS_LOCAL_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
# JARVIS_LOCAL_URL=http://localhost:11435


# ===================================================================
# Meeting mode
# ===================================================================
# Output devices to treat as headphones for meeting nudges, comma separated,
# exactly as macOS names them. Devices with headphone, AirPods, Buds, Beats
# or headset in the name already count; anything else gets visual nudges only.
# JARVIS_HEADPHONE_NAMES=USB Audio


# ===================================================================
# Local voice service (voice/server.py)
# ===================================================================
# JARVIS_VOICE_URL=http://127.0.0.1:8790
# JARVIS_WHISPER_MODEL=small.en
# JARVIS_KOKORO_VOICE=bm_george
# JARVIS_PIPER_VOICE=en_GB-alan-medium
# JARVIS_WAKE_THRESHOLD=0.5


# ===================================================================
# Bridge
# ===================================================================
# JARVIS_BRIDGE_PORT=8787
# Extra browser origins allowed to open the agent WebSocket, comma separated.
# JARVIS_ALLOWED_ORIGINS=
# Allow clients that send no Origin header (curl, scripts). Default 0.
# JARVIS_ALLOW_NO_ORIGIN=0
# Extra directories the /file endpoint may serve images from.
# JARVIS_FILE_ROOTS=


# ===================================================================
# Desktop app (desktop/)
# ===================================================================
# Where this checkout lives, if not ~/jarvis-home.
# JARVIS_HOME=/path/to/jarvis-home
