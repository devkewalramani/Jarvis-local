#!/bin/bash
# JankyBorders, Jarvis style: a soft cyan glow on the focused window only.
# Colours are 0xAARRGGBB; the cyan is Jarvis's --interface, #00e5ff.
# Linked from ~/.config/borders/bordersrc. Undo: desktop-theme/restore.sh
options=(
  style=round
  width=5.0
  hidpi=off
  active_color='glow(0xb300e5ff)'
  inactive_color=0x00000000
  # Jarvis is a see-through window; a glow round it would draw a rectangle
  # where there is meant to be no panel.
  blacklist="Jarvis"
)
borders "${options[@]}"
